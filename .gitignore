node_modules/
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
.coverage
dist/

# OS files
.DS_Store
Thumbs.db

# Telegram connector state (read position, questions asked); local only
managers/*/telegram/
